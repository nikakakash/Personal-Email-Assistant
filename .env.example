# Copy to .env and fill in. Placeholders ("replace-me") are rejected when
# OUTBOUND_EXECUTION_ENABLED=true.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/email_assistant
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_assistant

OWNER_EMAIL=owner@example.com
# Comma-separated additional addresses that count as the owner
OWNER_ALIASES=
OWNER_PASSPHRASE=replace-me
SESSION_SECRET=replace-me

ANTHROPIC_API_KEY=replace-me
LLM_PROVIDER=anthropic
MODEL_TRIAGE=claude-opus-5-5
MODEL_PLAN=claude-opus-5-5
MODEL_DRAFT=claude-opus-5-5
EFFORT_TRIAGE=low
EFFORT_PLAN=medium
EFFORT_DRAFT=medium

MAX_AGENT_STEPS=10
DAILY_BUDGET_USD=2.00
OUTBOUND_EXECUTION_ENABLED=false
POLL_INTERVAL_SECONDS=60
WORKER_LEASE_SECONDS=60
