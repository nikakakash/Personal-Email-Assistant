# Copy to .env and fill in. Placeholders ("replace-me") are rejected when
# OUTBOUND_EXECUTION_ENABLED=true.
APP_ENV=development
# The origin the browser uses (Docker web and `npm run dev` both serve on 8080);
# mutating requests from any other Origin are rejected.
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5433/email_assistant
CHECKPOINT_DATABASE_URL=postgresql://app:app@127.0.0.1:5433/email_assistant

# Used by compose.yaml and the DB test harness (tests use email_assistant_test)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=email_assistant

OWNER_EMAIL=owner@example.com
# Comma-separated additional addresses that count as the owner
OWNER_ALIASES=
# OWNER_PASSPHRASE and SESSION_SECRET must be at least 12 characters and not the
# placeholder: until then login returns 503 not_configured (production refuses to start).
OWNER_PASSPHRASE=replace-me
SESSION_SECRET=replace-me

ANTHROPIC_API_KEY=replace-me
LLM_PROVIDER=anthropic
MODEL_TRIAGE=claude-opus-5-5
MODEL_PLAN=claude-opus-5-5
MODEL_DRAFT=claude-opus-5-5
EFFORT_TRIAGE=low
EFFORT_PLAN=medium
EFFORT_DRAFT=medium

MAX_AGENT_STEPS=10
DAILY_BUDGET_USD=2.00
OUTBOUND_EXECUTION_ENABLED=false
POLL_INTERVAL_SECONDS=60
WORKER_LEASE_SECONDS=60
